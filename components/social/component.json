{
    "name": "social",
    "title": "Canyon Social",
    "description": "Elgg-based community layer: activity river, groups, messaging, notifications, profiles, widgets, menus, page ownership and search.",
    "version": "1.0.0",
    "type": "addon",
    "enabled": true,
    "requires": [
        "core"
    ],
    "autoload": {
        "psr-4": {
            "Canyon\\Core\\": "src"
        }
    },
    "classes": [
        "ActivityFeed",
        "GroupSystem",
        "Menu",
        "MessageSystem",
        "Notification",
        "PageOwnership",
        "River",
        "Search",
        "UserProfile",
        "Widget"
    ]
}
