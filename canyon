#!/usr/bin/env php
<?php
/**
 * Canyon CLI - Command line tool for the Canyon Framework
 * Supports: serve, routes, test, clear-cache, info, migrate, queue, config, component
 */

// Find the project root (a Canyon checkout: config.php + the core component).
// The CLI normally sits at the project root, but also works from a bin/ or
// vendor/bin/ directory.
$paths = [
    __DIR__,
    dirname(__DIR__),
    dirname(__DIR__, 2),
];

$basePath = null;
foreach ($paths as $p) {
    if (file_exists($p . '/config.php') && file_exists($p . '/components/core/src/Router.php')) {
        $basePath = realpath($p);
        break;
    }
}

if ($basePath === null) {
    fwrite(STDERR, "Canyon CLI: Unable to find project root\n");
    exit(1);
}

define('CANYON_BASE_PATH', $basePath);
define('CANYON_APP_PATH', $basePath . '/app');
define('CANYON_CONFIG_PATH', $basePath . '/config');
define('CANYON_ROUTES_PATH', $basePath . '/routes');
define('CANYON_RESOURCES_PATH', $basePath . '/resources');
define('CANYON_STORAGE_PATH', $basePath . '/storage');
define('CANYON_FRAMEWORK_PATH', $basePath);
define('CANYON_COMPONENTS_PATH', $basePath . '/components');

// ---------------------------------------------------------------------------
// Components + autoloader (mirrors public/index.php, without the HTTP bits).
// ---------------------------------------------------------------------------

require_once CANYON_FRAMEWORK_PATH . '/app/Helpers/components.php';

$disabledComponents = [];
$componentsConfigFile = $basePath . '/components.json';
if (is_file($componentsConfigFile)) {
    $decoded = json_decode((string) file_get_contents($componentsConfigFile), true);
    if (is_array($decoded) && isset($decoded['disabled'])) {
        $disabledComponents = array_values(array_map('strval', (array) $decoded['disabled']));
    }
}

$componentManifests = canyon_discover_components(CANYON_COMPONENTS_PATH);
$enabledComponents = canyon_resolve_components($componentManifests, $disabledComponents);
$componentPsr4 = canyon_component_psr4($enabledComponents);

spl_autoload_register(function ($class) use ($componentPsr4) {
    if (!str_starts_with($class, 'Canyon\\')) {
        return;
    }

    $relativeClass = str_replace('\\', '/', substr($class, strlen('Canyon\\'))) . '.php';

    $appFile = CANYON_APP_PATH . '/' . $relativeClass;
    if (is_file($appFile)) {
        require $appFile;
        return;
    }

    foreach ($componentPsr4 as $prefix => $directories) {
        if (!str_starts_with($class, $prefix)) {
            continue;
        }

        $componentRelative = str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';

        foreach ($directories as $directory) {
            $file = $directory . '/' . $componentRelative;
            if (is_file($file)) {
                require $file;
                return;
            }
        }
    }

    $frameworkFile = CANYON_FRAMEWORK_PATH . '/app/' . $relativeClass;
    if (is_file($frameworkFile)) {
        require $frameworkFile;
    }
});

require_once CANYON_FRAMEWORK_PATH . '/app/Helpers/env.php';
require_once CANYON_FRAMEWORK_PATH . '/app/Helpers/functions.php';

foreach (canyon_component_files($enabledComponents) as $componentFile) {
    require_once $componentFile;
}

if (is_file(CANYON_APP_PATH . '/Helpers/app.php')) {
    require_once CANYON_APP_PATH . '/Helpers/app.php';
}

// Composer's autoloader last, so the component map above wins for Canyon\Core\*.
if (is_file($basePath . '/vendor/autoload.php')) {
    require_once $basePath . '/vendor/autoload.php';
}

use Canyon\Core\Application;
use Canyon\Core\Component;
use Canyon\Core\Router;
use Canyon\Core\Config;
use Canyon\Core\Migration;
use Canyon\Core\Queue;

Application::init();
Config::init();
Component::boot(CANYON_COMPONENTS_PATH, $disabledComponents);

// Load .env if exists
if (file_exists($basePath . '/.env')) {
    $envLines = file($basePath . '/.env', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($envLines as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#') || !str_contains($line, '=')) continue;
        $separatorPos = strpos($line, '=');
        $key = trim(substr($line, 0, $separatorPos));
        $value = trim(substr($line, $separatorPos + 1));
        if (preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $key)) {
            $_ENV[$key] = $value;
        }
    }
}

$command = $argv[1] ?? 'help';

echo "Canyon Framework CLI v0.4.0\n";
echo "Project: " . env('APP_NAME', 'Canyon Framework') . "\n";
echo "Environment: " . env('APP_ENV', 'production') . "\n\n";

switch ($command) {
    case 'serve':
        $port = $argv[2] ?? '8000';
        $host = $argv[3] ?? '127.0.0.1';
        echo "Starting development server at http://{$host}:{$port}\n";
        echo "Press Ctrl+C to stop.\n\n";
        $docRoot = $basePath . '/public';
        passthru("php -S {$host}:{$port} -t {$docRoot}");
        break;

    case 'routes':
        echo "Registered Routes:\n";
        $routes = Router::getRoutes();
        foreach ($routes as $route) {
            printf("  %-6s %s  -> %s\n",
                $route['method'],
                $route['uri'],
                is_array($route['handler'])
                    ? $route['handler'][0] . '::' . $route['handler'][1]
                    : (is_string($route['handler']) ? $route['handler'] : 'closure')
            );
        }
        break;

    case 'test':
        echo "Running framework security tests...\n";
        $testFile = $basePath . '/tests/security-test.php';
        if (file_exists($testFile)) {
            require $testFile;
        } else {
            echo "No test file found at tests/security-test.php\n";
            echo "Create one or run: canyon serve && curl -I http://localhost:8000/\n";
        }
        break;

    case 'clear-cache':
        $cacheDir = $basePath . '/storage/cache';
        if (is_dir($cacheDir)) {
            $files = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($cacheDir, RecursiveDirectoryIterator::SKIP_DOTS),
                RecursiveIteratorIterator::CHILD_FIRST
            );
            foreach ($files as $file) {
                if ($file->isDir()) {
                    rmdir($file->getRealPath());
                } else {
                    unlink($file->getRealPath());
                }
            }
        }
        echo "Cache cleared.\n";
        break;

    case 'component':
    case 'components':
        $action = $argv[2] ?? 'list';
        $name = $argv[3] ?? null;

        switch ($action) {
            case 'list':
                echo "Components:\n\n";
                printf("  %-13s %-9s %-8s %-7s %s\n", 'NAME', 'VERSION', 'TYPE', 'CLASSES', 'STATUS');
                foreach (Component::info() as $row) {
                    $status = $row['enabled'] ? 'enabled' : 'DISABLED';
                    if ($row['required']) {
                        $status .= ' (required)';
                    }
                    printf("  %-13s %-9s %-8s %-7d %s\n",
                        $row['name'], $row['version'], $row['type'], $row['classes'], $status);
                }
                echo "\n  Components live in " . CANYON_COMPONENTS_PATH . "\n";
                echo "  Enable/disable decisions are stored in " . Component::configPath() . "\n";
                break;

            case 'show':
                if ($name === null || !Component::exists($name)) {
                    echo "Usage: canyon component show <name>\n";
                    break;
                }
                $manifest = Component::manifest($name);
                echo "Component: {$manifest['name']}\n";
                echo "  Title:       " . ($manifest['title'] ?? '-') . "\n";
                echo "  Version:     " . ($manifest['version'] ?? '-') . "\n";
                echo "  Type:        " . ($manifest['type'] ?? '-') . "\n";
                echo "  Enabled:     " . (Component::isEnabled($name) ? 'yes' : 'no') . "\n";
                echo "  Requires:    " . (implode(', ', (array) ($manifest['requires'] ?? [])) ?: 'none') . "\n";
                echo "  Path:        " . ($manifest['__path'] ?? '-') . "\n";
                echo "  Description: " . ($manifest['description'] ?? '-') . "\n";
                $classes = (array) ($manifest['classes'] ?? []);
                echo "  Classes (" . count($classes) . "):\n";
                foreach ($classes as $class) {
                    echo "    - {$class}\n";
                }
                break;

            case 'enable':
            case 'disable':
                if ($name === null || !Component::exists($name)) {
                    echo "Usage: canyon component {$action} <name>\n";
                    break;
                }
                if (Component::setEnabled($name, $action === 'enable')) {
                    echo "Component '{$name}' " . ($action === 'enable' ? 'enabled' : 'disabled') . ".\n";
                } else {
                    echo "Could not {$action} '{$name}' — it may be the mandatory core component.\n";
                }
                break;

            default:
                echo "Usage: canyon component [list|show <name>|enable <name>|disable <name>]\n";
        }
        break;

    case 'migrate':
        $action = $argv[2] ?? 'migrate';
        $migration = new Migration();

        switch ($action) {
            case 'migrate':
                $migrated = $migration->migrate();
                if (empty($migrated)) {
                    echo "Nothing to migrate.\n";
                } else {
                    echo "Migrated " . count($migrated) . " file(s):\n";
                    foreach ($migrated as $m) {
                        echo "  - {$m}\n";
                    }
                }
                break;

            case 'rollback':
                $rolledBack = $migration->rollback();
                if (empty($rolledBack)) {
                    echo "Nothing to rollback.\n";
                } else {
                    echo "Rolled back " . count($rolledBack) . " migration(s):\n";
                    foreach ($rolledBack as $m) {
                        echo "  - {$m}\n";
                    }
                }
                break;

            case 'reset':
                $reset = $migration->reset();
                echo "Reset " . count($reset) . " migration(s).\n";
                break;

            case 'status':
                $status = $migration->status();
                echo "Migration Status:\n";
                echo "  Total: " . $status['total'] . "\n";
                echo "  Executed: " . count($status['executed']) . "\n";
                echo "  Pending: " . count($status['pending']) . "\n";
                if (!empty($status['executed'])) {
                    echo "\nExecuted:\n";
                    foreach ($status['executed'] as $m) {
                        echo "  [x] {$m}\n";
                    }
                }
                if (!empty($status['pending'])) {
                    echo "\nPending:\n";
                    foreach ($status['pending'] as $m) {
                        echo "  [ ] {$m}\n";
                    }
                }
                break;

            default:
                echo "Usage: canyon migrate [migrate|rollback|reset|status]\n";
        }
        break;

    case 'queue':
        $action = $argv[2] ?? 'work';

        switch ($action) {
            case 'work':
                $maxJobs = (int) ($argv[3] ?? 0);
                $processed = Queue::work($maxJobs);
                if (empty($processed)) {
                    echo "No jobs processed.\n";
                } else {
                    echo "Processed " . count($processed) . " job(s):\n";
                    foreach ($processed as $job) {
                        $status = $job['success'] ? 'success' : 'failed';
                        echo "  [{$status}] {$job['class']}\n";
                    }
                }
                break;

            case 'status':
                $pending = Queue::pending();
                $failed = Queue::failed();
                echo "Queue Status:\n";
                echo "  Pending jobs: " . count($pending) . "\n";
                echo "  Failed jobs: " . count($failed) . "\n";
                if (!empty($pending)) {
                    echo "\nPending:\n";
                    foreach ($pending as $job) {
                        echo "  - {$job['class']} (available at: " . date('Y-m-d H:i:s', $job['available_at']) . ")\n";
                    }
                }
                if (!empty($failed)) {
                    echo "\nFailed:\n";
                    foreach ($failed as $job) {
                        echo "  - {$job['class']} (error: {$job['error']})\n";
                    }
                }
                break;

            case 'clear':
                Queue::clear();
                echo "Queue cleared.\n";
                break;

            case 'clear-failed':
                Queue::clearFailed();
                echo "Failed jobs cleared.\n";
                break;

            default:
                echo "Usage: canyon queue [work|status|clear|clear-failed]\n";
        }
        break;

    case 'config':
        echo "Configuration:\n";
        $config = Config::all();
        foreach ($config as $file => $data) {
            echo "\n[{$file}]\n";
            printConfig($data, '  ');
        }
        break;

    case 'info':
        echo "Framework: Canyon\n";
        echo "Version: 0.4.0\n";
        echo "PHP: " . PHP_VERSION . "\n";
        echo "Base Path: $basePath\n";
        echo "Debug: " . (env('APP_DEBUG') ? 'yes' : 'no') . "\n";
        echo "Environment: " . env('APP_ENV', 'production') . "\n";
        echo "Database: " . env('DB_CONNECTION', 'mysql') . "\n";
        echo "Components: " . count(Component::enabledNames()) . " enabled / " . count(Component::all()) . " installed\n";
        echo "  enabled: " . (implode(', ', Component::enabledNames()) ?: 'none') . "\n";
        if (Component::disabledNames()) {
            echo "  disabled: " . implode(', ', Component::disabledNames()) . "\n";
        }
        break;

    default:
        echo "Available commands:\n";
        echo "  serve [port] [host]    Start development server\n";
        echo "  routes                 List registered routes\n";
        echo "  component [action]     Manage components (list|show|enable|disable)\n";
        echo "  migrate [action]       Run migrations (migrate|rollback|reset|status)\n";
        echo "  queue [action]         Queue operations (work|status|clear|clear-failed)\n";
        echo "  config                 Show configuration\n";
        echo "  test                   Run framework tests\n";
        echo "  clear-cache            Clear storage cache\n";
        echo "  info                   Show framework info\n";
        echo "  help                   Show this help\n";
}

/**
 * Recursively print config data.
 */
function printConfig(array $data, string $indent = ''): void
{
    foreach ($data as $key => $value) {
        if (is_array($value)) {
            echo "{$indent}{$key}:\n";
            printConfig($value, $indent . '  ');
        } else {
            $display = is_bool($value) ? ($value ? 'true' : 'false') : $value;
            if (str_contains(strtolower((string) $key), 'password') || str_contains(strtolower((string) $key), 'secret')) {
                $display = '********';
            }
            echo "{$indent}{$key}: {$display}\n";
        }
    }
}
