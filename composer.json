{
    "name": "canyon/framework",
    "description": "A minimal PHP framework inspired by Laravel and CodeIgniter, assembled from components",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Canyon\\Core\\": [
                "components/core/src",
                "components/ai/src",
                "components/social/src",
                "components/security/src",
                "components/performance/src"
            ],
            "Canyon\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "bin": [
        "canyon"
    ],
    "license": "MIT",
    "keywords": ["framework", "mvc", "laravel", "codeigniter", "php"]
}
