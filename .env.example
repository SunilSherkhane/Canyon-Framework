# Canyon Framework - Environment Configuration Example
# Copy this file to .env and adjust the values for your environment.
# NEVER commit the real .env file to version control.

# Application
APP_NAME="Canyon Framework"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Timezone (PHP supported identifier)
TIMEZONE=UTC

# Allowed Hosts
# Comma-separated list. Wildcard subdomains supported: *.example.com
# Leave blank to allow only localhost / 127.0.0.1 (development default).
ALLOWED_HOSTS=localhost,127.0.0.1

# Security Headers
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# CORS
# Comma-separated list of allowed origins. Leave empty to disallow all.
CORS_ALLOWED_ORIGINS=

# Database (used by config/app.php)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=canyon
DB_USERNAME=root
DB_PASSWORD=